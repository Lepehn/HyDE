xdg-desktop-portal-hyprland                 # Hyprland backend for XDG desktop portal
xdg-desktop-portal-gtk                      # GTK fallback portal (file chooser/DBus)
xdg-user-dirs                               # Standard user directory generator
libnotify                                   # Desktop notification library
pacman-contrib                              # Arch package maintenance scripts
parallel                                    # Shell execution parallelism tool
jq                                          # Command-line JSON processor
imagemagick                                 # Image manipulation tool set
# ==============================================================================
