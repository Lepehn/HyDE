hypridle                                    # Idle management daemon
hyprlock                                    # Screen locker
hyprsunset                                  # Blue light filter / color temperature
waybar                                      # Customizable GTK status bar
rofi-wayland                                # Application launcher and switcher
dunst                                       # Lightweight notification daemon
awww                                        # Wayland wallpaper daemon
wlogout                                     # Graphical logout menu
nwg-displays                                # Monitor layout management GUI

# ==============================================================================
