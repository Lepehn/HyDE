# ==============================================================================
# CORE SYSTEM & DAEMONS
# ==============================================================================
uwsm                                        # Standalone Wayland session manager
networkmanager                              # Network management daemon
network-manager-applet                      # System tray applet for NetworkManager
bluez                                       # Bluetooth protocol stack
bluez-utils                                 # Bluetooth CLI tools
blueman                                     # Bluetooth GUI manager
udiskie                                     # Automatic removable media mounting
brightnessctl                               # Display brightness control
playerctl                                   # Media player controller (MPRIS)

# ==============================================================================
# AUDIO PIPELINE (PIPEWIRE)
# ==============================================================================
pipewire                                    # Core audio/video server
wireplumber                                 # PipeWire session manager
pipewire-audio                              # Audio support
pipewire-alsa                               # ALSA compatibility plugin
pipewire-pulse                              # PulseAudio compatibility plugin
pipewire-jack                               # JACK compatibility plugin
gst-plugin-pipewire                         # GStreamer PipeWire plugin
pavucontrol                                 # PulseAudio/PipeWire GUI volume control
pamixer                                     # Command-line volume control

# ==============================================================================
# DISPLAY MANAGER & LOGIN
# ==============================================================================
sddm                                        # QML-based display manager
qt5-quickcontrols                           # SDDM theme support
qt5-quickcontrols2                          # SDDM theme support
qt5-graphicaleffects                        # SDDM visual effects

# ==============================================================================
# DESKTOP ENVIRONMENT & WAYLAND UTILITIES
# ==============================================================================
